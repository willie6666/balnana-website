// The website runs as a Cloudflare Worker that only serves the static files in build/web.
// Workers Builds runs `npm run build` and then `npx wrangler deploy` on every push; see dev-docs/DEPLOYMENT.md.
{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "balnana-website",
	"compatibility_date": "2026-11-01",
	// The site is served only on the custom domains set in the dashboard (Settings > Domains & Routes).
	// Every deploy applies these two settings, so they must stay false here; otherwise the
	// workers.dev address and the preview URLs turn back on with the next deploy.
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./build/web",
		// /en is served from en.html and /docs/ from docs/index.html; /en.html and /docs redirect to them.
		"html_handling": "auto-trailing-slash",
		// Unknown addresses get the top-level 404.html with a 404 status.
		"not_found_handling": "404-page"
	}
}
